# Server
PORT=8080
ENV=development

# Database
# Note: Use DB_HOST=localhost for local development, or DB_HOST=postgres for Docker
DB_HOST=localhost
DB_PORT=5432
DB_USER=parlance
DB_PASSWORD=secret
DB_NAME=parlance
DB_SSL_MODE=disable

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=24h

# DeepL
DEEPL_API_KEY=your-deepl-key
DEEPL_API_URL=https://api.deepl.com/v2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
