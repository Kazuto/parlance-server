# Server
PORT=8080
ENV=development

# Database
# Note: Use DB_HOST=localhost for local development, or DB_HOST=postgres for Docker
DB_HOST=localhost
DB_PORT=5432
DB_USER=parlance
DB_PASSWORD=secret
DB_NAME=parlance
DB_SSL_MODE=disable

# S3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=parlance

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=24h

# Encrypts stored secrets, such as API keys of translation servers (set up under
# Settings) and access tokens of tasks. Needed only to save them; changing it makes
# saved ones unreadable.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
