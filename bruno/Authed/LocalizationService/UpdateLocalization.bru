meta {
  name: UpdateLocalization
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/parlance.v1.LocalizationService/UpdateLocalization
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{localizationId}}",
    "translation": "Updated translation text"
  }
}

script:pre-request {
  const localizationId = bru.getVar('localizationId');

  if (!localizationId) {
      await bru.runRequest('Authed/LocalizationService/ListLocalizations');

      return;
  }
}

docs {
  # UpdateLocalization

  Updates an existing localization's translation text.

  ## Request
  - `id` (required): UUID of the localization to update
  - `translation` (required): The new translation text

  ## Response
  - `localization`: The updated localization with new translation and metadata

  ## User Tracking
  The authenticated user is automatically recorded as `updated_by`.

  ## History
  Changes are automatically tracked in `localization_histories` via GORM hooks.

  ## Error Codes
  - `INVALID_ARGUMENT`: Missing required fields
  - `NOT_FOUND`: Localization does not exist

  ## Example Use Case
  Translator edits an existing translation to improve accuracy or fix errors.
}
