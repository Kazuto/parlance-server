meta {
  name: Delete Localization
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/parlance.v1.LocalizationService/DeleteLocalization
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: en
}

body:json {
  {
    "id": "{{localizationId}}"
  }
}

script:pre-request {
  const localizationId = bru.getVar('localizationId');
  
  if (!localizationId) {
      await bru.runRequest('Authed/LocalizationService/ListLocalizations');
  
      return;
  }
}

docs {
  # Delete Localization
  
  Soft deletes a localization (sets deleted_at timestamp).
  
  ## Authentication
  Requires valid access token.
  
  ## Request
  - `id` (required): UUID of the localization to delete
  
  ## Response
  - Empty response on success
  
  ## User Tracking
  The authenticated user is automatically recorded as the deleter.
  
  ## Soft Delete
  The localization is not permanently removed - it's marked as deleted with a timestamp.
  History is preserved.
  
  ## Error Codes
  - `INVALID_ARGUMENT`: Missing localization ID
  - `NOT_FOUND`: Localization does not exist
  
  ## Example Use Case
  Remove an incorrect or outdated translation while preserving history.
}
