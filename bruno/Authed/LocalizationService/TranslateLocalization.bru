meta {
  name: TranslateLocalization
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/parlance.v1.LocalizationService/TranslateLocalization
  body: json
  auth: inherit
}

body:json {
  {
    "entryId": "{{entryId}}",
    "sourceLocaleId": "en",
    "targetLocaleId": "de"
  }
}

script:pre-request {
  const entryId = bru.getVar('entryId');

  if (!entryId) {
      await bru.runRequest('Authed/EntryService/ListEntries');

      return;
  }
}

docs {
  # TranslateLocalization

  Uses AI (DeepL) to automatically translate an entry from source locale to target locale.

  ## Request
  - `entry_id` (required): ID of the entry to translate
  - `source_locale_id` (required): Locale ID to translate from (e.g., "en")
  - `target_locale_id` (required): Locale ID to translate to (e.g., "de")

  ## Response
  - `localization`: The created or updated localization with AI-generated translation

  ## Behavior
  - If target localization exists: updates it with new translation
  - If target localization doesn't exist: creates a new one

  ## User Tracking
  The authenticated user is recorded as creator/updater of the AI translation.

  ## Error Codes
  - `INVALID_ARGUMENT`: Missing required fields
  - `NOT_FOUND`: Source localization does not exist

  ## Example Use Case
  Quickly generate initial translations for entries using AI, then let translators refine them.

  ## Note
  Currently returns placeholder "[AI-Translated from source]" prefix.
  TODO: Integrate DeepL API for real translations.
}
