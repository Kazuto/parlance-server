meta {
  name: Update Definition
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/parlance.v1.DefinitionService/UpdateDefinition
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: en
}

body:json {
  {
    "id": "{{definitionId}}",
    "translation": "Updated definition with refined guidelines"
  }
}

script:pre-request {
  const definitionId = bru.getVar('definitionId');
  
  if (!definitionId) {
      await bru.runRequest('Authed/DefinitionService/ListDefinitions');
  
      return;
  }
}

docs {
  # Update Definition
  
  Updates the translation/definition for a terminology term in a specific locale.
  
  ## Authentication
  Requires valid access token.
  
  ## Request
  - `id` (required): UUID of the definition to update
  - `translation` (required): The updated definition/translation
  
  ## Response
  - `definition`: The updated definition with new translation
  
  ## User Tracking
  The authenticated user is automatically recorded as `updated_by`.
  
  ## History
  Updates are automatically tracked in `definition_history` via GORM hooks.
  
  ## Error Codes
  - `INVALID_ARGUMENT`: Missing required fields
  - `NOT_FOUND`: Definition not found
  
  ## Example Use Case
  Refine the translation guidelines when translators need clarification.
  For example, change from "Use 'API' as-is" to "Use 'API' untranslated, but expand to 'Application Programming Interface' on first occurrence".
}
