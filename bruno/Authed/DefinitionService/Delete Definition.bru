meta {
  name: Delete Definition
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/parlance.v1.DefinitionService/DeleteDefinition
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{definitionId}}"
  }
}

script:pre-request {
  const definitionId = bru.getVar('definitionId');
  
  if (!definitionId) {
      await bru.runRequest('Authed/DefinitionService/ListDefinitions');
  
      return;
  }
}

docs {
  # Delete Definition
  
  Soft deletes a definition for a terminology term in a specific locale.
  
  ## Authentication
  Requires valid access token.
  
  ## Request
  - `id` (required): UUID of the definition to delete
  
  ## Response
  - Empty response on success
  
  ## User Tracking
  The authenticated user is recorded as the deleter.
  
  ## Soft Delete
  The definition is not permanently removed - it's marked as deleted with a timestamp.
  History is preserved in `definition_history`.
  
  ## History
  Deletion is automatically tracked in `definition_history` via GORM hooks.
  
  ## Error Codes
  - `INVALID_ARGUMENT`: Missing definition ID
  - `NOT_FOUND`: Definition not found
  
  ## Example Use Case
  Remove an outdated or incorrect translation guideline while preserving the audit trail.
}
