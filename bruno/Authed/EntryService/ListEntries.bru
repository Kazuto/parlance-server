meta {
  name: List Entries
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/parlance.v1.EntryService/ListEntries
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pagination": {
      "page": 1,
      "perPage": 20
    },
    "scopeId": "",
    "localeId": ""
  }
}

script:post-response {
  const data = res?.body?.entries;

  if (data) {
    const ids = data.map((el) => el.id);

    bru.setVar("entryIds", ids);
    bru.setVar("entryId", ids.shift());
  }
}

docs {
  # List Entries

  Retrieves a paginated list of translation entries.

  ## Authentication
  Requires valid access token.

  ## Request
  - `pagination.page` (optional): Page number, defaults to 1
  - `pagination.perPage` (optional): Items per page, defaults to 20, max 100
  - `scopeId` (optional): Filter by scope UUID
  - `localeId` (optional): Filter by locale UUID (shows only entries with translations in this locale)

  ## Response
  Returns entries with their localizations and scopes.

  ## Example Response
  ```json
  {
    "entries": [
      {
        "id": "uuid",
        "key": "button.save",
        "description": "Save button label",
        "createdAt": "2026-03-27T19:00:00+01:00",
        "updatedAt": "2026-03-27T19:00:00+01:00",
        "createdBy": "user-uuid",
        "updatedBy": "user-uuid",
        "localizations": [
          {
            "id": "uuid",
            "entryId": "uuid",
            "localeId": "locale-uuid",
            "translation": "Save",
            "createdAt": "2026-03-27T19:00:00+01:00",
            "updatedAt": "2026-03-27T19:00:00+01:00"
          }
        ],
        "scopes": [
          {
            "id": "uuid",
            "name": "Frontend",
            "slug": "frontend",
            "description": "Frontend UI translations",
            "color": "#3B82F6"
          }
        ]
      }
    ],
    "pagination": {
      "total": 50,
      "page": 1,
      "perPage": 20,
      "totalPages": 3
    }
  }
  ```
}
