meta {
  name: Restore Entry
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/parlance.v1.EntryService/RestoreEntry
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: en
}

body:json {
  {
    "id": "{{entryId}}"
  }
}

script:pre-request {
  const entryId = bru.getVar('entryId');

  if (!entryId) {
      await bru.runRequest('Authed/EntryService/ListEntries');

      return;
  }
}

docs {
  # Restore Entry

  Restores a translation entry by its ID.

  ## Authentication
  Requires valid access token.

  ## Request
  - `id` (required): The UUID of the entry to retrieve

  ## Response
  Returns the entry with all localizations and scopes.

  ## Example Response
  ```json
  {
    "entry": {
      "id": "uuid",
      "key": "button.save",
      "description": "Save button label",
      "createdAt": "2026-03-27T19:00:00+01:00",
      "updatedAt": "2026-03-27T19:00:00+01:00",
      "createdBy": "user-uuid",
      "updatedBy": "user-uuid",
      "localizations": [...],
      "scopes": [...]
    }
  }
  ```

  ## Errors
  - `INVALID_ARGUMENT`: entry id is required
  - `NOT_FOUND`: entry not found
}
