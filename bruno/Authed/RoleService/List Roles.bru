meta {
  name: List Roles
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/parlance.v1.RoleService/ListRoles
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: en
}

body:json {
  {
    "pagination": {
      "page": 1,
      "perPage": 20
    },
    "filter": {
      // "search": "en",
      "sort": "created_at",
      "order": "ASC",
      "include_deleted": true
    }
  }
}

script:post-response {
  const data = res?.body?.roles;
  
  if (data) {
    const ids = data.map((el) => el.id);
  
    bru.setVar("roleIds", ids);
    bru.setVar("roleId", ids.shift());
  }
}

docs {
  # List Roles
  
  Retrieves a paginated list of all roles and their permissions in the system.
  
  ## Authentication
  Requires valid access token.
  
  ## Request
  - `pagination.page` (optional): Page number, defaults to 1
  - `pagination.perPage` (optional): Items per page, defaults to 20, max 100
  
  ## Response
  Returns an array of roles with nested permissions.
  
  ## Example Response
  ```json
  {
    "roles": [
      {
        "id": "700e51e6-8cad-412a-b3c4-12a1d7efd402",
        "name": "Viewer",
        "description": "Allows the user to view translations."
      },
      {
        "id": "4ff3cc5a-6d62-401e-95d4-120b32673a4a",
        "name": "admin",
        "description": "Allows the user to view translations",
        "permissions": [
          {
            "id": "7f3249f3-41e3-400d-9ad7-4c27c943f66a",
            "name": "create_entry",
            "resource": "entry",
            "action": "create"
          },
          {
            "id": "b09fe03f-a62e-4e71-a83d-a7eff2e76301",
            "name": "read_entry",
            "resource": "entry",
            "action": "read"
          },
          {
            "id": "e64d42cf-f57e-4c60-a22d-a198e873be17",
            "name": "update_entry",
            "resource": "entry",
            "action": "update"
          },
          {
            "id": "2ee6d220-563a-4214-9ca9-31d80068b02e",
            "name": "delete_entry",
            "resource": "entry",
            "action": "delete"
          },
          {
            "id": "58beac90-1f3e-4097-b08b-4e03eb0838b7",
            "name": "create_locale",
            "resource": "locale",
            "action": "create"
          },
          {
            "id": "265a2983-0349-4ac5-8b3b-783ae7a55e7d",
            "name": "manage_users",
            "resource": "user",
            "action": "manage"
          },
          {
            "id": "31d1caf4-3765-4195-b856-6ff41333a80f",
            "name": "manage_terminology",
            "resource": "terminology",
            "action": "manage"
          }
        ]
      },
      {
        "id": "d0118e6d-5eee-405a-9d39-78970658e96e",
        "name": "translator",
        "permissions": [
          {
            "id": "7f3249f3-41e3-400d-9ad7-4c27c943f66a",
            "name": "create_entry",
            "resource": "entry",
            "action": "create"
          },
          {
            "id": "b09fe03f-a62e-4e71-a83d-a7eff2e76301",
            "name": "read_entry",
            "resource": "entry",
            "action": "read"
          },
          {
            "id": "e64d42cf-f57e-4c60-a22d-a198e873be17",
            "name": "update_entry",
            "resource": "entry",
            "action": "update"
          }
        ]
      },
      {
        "id": "a8e6b53d-7947-49f1-badd-9db464aefe8e",
        "name": "viewer",
        "permissions": [
          {
            "id": "b09fe03f-a62e-4e71-a83d-a7eff2e76301",
            "name": "read_entry",
            "resource": "entry",
            "action": "read"
          }
        ]
      }
    ],
    "pagination": {
      "total": 4,
      "page": 1,
      "perPage": 20,
      "totalPages": 1
    }
  }
  ```
}
