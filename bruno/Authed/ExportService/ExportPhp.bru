meta {
  name: ExportPhp
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/parlance.v1.ExportService/ExportPhp
  body: json
  auth: inherit
}

body:json {
  {
    "localeCode": "en",
    "scopeId": ""
  }
}

docs {
  # ExportPhp

  Exports translations in PHP PHP format for use in PHP applications.

  ## Request
  - `locale_code` (required): Locale to export (e.g., "en", "de")
  - `scope_id` (optional): Filter by scope ID to export only specific entries

  ## Response
  - `format`: "PHP"
  - `content`: PHP file content with array of translations
  - `filename`: Suggested filename (e.g., "en.php" or "admin_en.php")

  ## Output Format
  ```php
  <?php

  return [
      'welcome.message' => 'Welcome to our application',
      'login.button' => 'Sign In',
  ];
  ```

  ## Use Case
  Export translations for PHP projects to place in `resources/lang/{locale}/` directory.

  ## Features
  - Automatically escapes single quotes in translations
  - Supports scope filtering for modular exports
  - Generates filename based on locale and scope
}
