meta {
  name: Get Entry Scopes
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/parlance.v1.ScopeService/GetEntryScopes
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: en
}

body:json {
  {
    "entryId": "{{entryId}}"
  }
}

script:pre-request {
  const entryId = bru.getVar('entryId');

  if (!entryId) {
      await bru.runRequest('Authed/EntryService/ListEntries');

      return;
  }
}

docs {
  # Get Entry Scopes

  Returns all scopes associated with a translation entry.

  ## Request
  - `entryId` (required): The UUID of the entry

  ## Response
  Returns an array of scopes for the entry.

  ## Example Response
  ```json
  {
    "scopes": [
      {
        "id": "uuid",
        "name": "Frontend",
        "slug": "frontend",
        "description": "Frontend UI translations",
        "color": "#3B82F6",
        "createdAt": "2026-03-27T18:27:04+01:00",
        "updatedAt": "2026-03-27T18:27:04+01:00"
      },
      {
        "id": "uuid",
        "name": "Mobile App",
        "slug": "mobile",
        "description": "Mobile application translations",
        "color": "#EC4899",
        "createdAt": "2026-03-27T18:45:00+01:00",
        "updatedAt": "2026-03-27T18:45:00+01:00"
      }
    ]
  }
  ```

  ## Use Case
  Use this to determine which parts of the application use a specific translation entry.

  ## Errors
  - `INVALID_ARGUMENT`: entry id is required
  - `NOT_FOUND`: entry not found
}
