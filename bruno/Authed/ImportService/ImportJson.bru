    "fileContent": "ewogICJ3ZWxjb21lLm1lc3NhZ2UiOiAiV2VsY29tZSB0byBvdXIgYXBwbGljYXRpb24iLAogICJ1c2VyLnByb2ZpbGUubmFtZSI6ICJOYW1lIiwKICAibG9naW4uYnV0dG9uIjogIlNpZ24gSW4iCn0=",
    "filename": "en.json",
    "mode": "CREATE_OR_UPDATE"
  }
