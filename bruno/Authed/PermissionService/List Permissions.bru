meta {
  name: List Permissions
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/parlance.v1.PermissionService/ListPermissions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pagination": {
      "page": 1,
      "perPage": 20
    }
  }
}

script:post-response {
  const data = res?.body?.permissions;
  
  if (data) {
    const ids = data.map((el) => el.id);
  
    bru.setVar("permissionsId", ids);
    bru.setVar("permissionId", ids.shift());
  }
}

docs {
  # List Permissions
  
  Retrieves a paginated list of all permissions in the system.
  
  ## Authentication
  Requires valid access token.
  
  ## Request
  - `pagination.page` (optional): Page number, defaults to 1
  - `pagination.perPage` (optional): Items per page, defaults to 20, max 100
  
  ## Response
  Returns an array of permissions.
  
  ## Example Response
