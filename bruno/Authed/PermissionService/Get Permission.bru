meta {
  name: Get Permission
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/parlance.v1.PermissionService/GetPermission
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{permissionId}}"
  }
}

script:pre-request {
  const permissionId = bru.getVar('permissionId');
  
  if (!permissionId) {
      await bru.runRequest('Authed/PermissionService/ListPermissions');
  
      return;
  }
}

docs {
  # Get Permission
  
  Retrieves a single permission by their ID.
  
  ## Authentication
  Requires valid access token.
  
  ## Request
  - `id` (required): The UUID of the permission to retrieve
  
  ## Response
  Returns the permission details.
  
  ## Example Response
  ```json
  {
    "permission": {
      "id": "f6bb985e-c166-45da-bbdb-1ae94ad2e407",
      "name": "create_Permission",
      "resource": "Permission",
      "action": "create"
    }
  }
  ```
  
  ## Errors
  - `INVALID_ARGUMENT`: permission id is required
  - `NOT_FOUND`: permission not found
}
