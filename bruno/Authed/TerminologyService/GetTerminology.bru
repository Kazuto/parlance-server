meta {
  name: GetTerminology
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/parlance.v1.TerminologyService/GetTerminology
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{terminologyId}}"
  }
}

script:pre-request {
  const terminologyId = bru.getVar('terminologyId');

  if (!terminologyId) {
      await bru.runRequest('Authed/TerminologyService/ListTerminologies');

      return;
  }
}

docs {
  # GetTerminology

  Retrieves a specific terminology entry by ID with all its definitions.

  ## Request
  - `id` (required): UUID of the terminology entry

  ## Response
  - `terminology`: The terminology object with term, description, and all locale definitions

  ## Error Codes
  - `INVALID_ARGUMENT`: Missing terminology ID
  - `NOT_FOUND`: Terminology with the given ID does not exist

  ## Example Use Case
  View details of a specific glossary term including how it should be translated in all locales.
}
