meta {
  name: Restore Locale
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/parlance.v1.LocaleService/RestoreLocale
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept-Language: en
}

body:json {
  {
    "id": "{{localeId}}"
  }
}

script:pre-request {
  const localeId = bru.getVar('localeId');

  if (!localeId) {
      await bru.runRequest('Authed/LocaleService/ListLocales');

      return;
  }
}

docs {
  # Restore Locale

  Restores a locale by its ID.

  ## Authentication
  Requires valid access token.

  ## Request
  - `id` (required): The UUID of the locale to retrieve

  ## Response
  Returns the locale details.

  ## Example Response
  ```json
  {
    "locale": {
      "id": "uuid",
      "code": "en",
      "name": "English",
      "names": {
        "en": "English",
        "de": "Englisch",
        "fr": "Anglais"
      },
      "isDefault": true,
      "createdAt": "2026-03-27T18:12:31+01:00",
      "updatedAt": "2026-03-27T18:12:31+01:00"
    }
  }
  ```

  **Note**: The `name` field is localized based on `Accept-Language` header.

  ## Errors
  - `INVALID_ARGUMENT`: locale id is required
  - `NOT_FOUND`: locale not found
}
