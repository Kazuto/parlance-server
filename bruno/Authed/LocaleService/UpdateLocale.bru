meta {
  name: Update Locale
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/parlance.v1.LocaleService/UpdateLocale
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{localeId}}",
    "code": "de",
    "names": {
      "en": "German",
      "de": "Deutsch",
      "fr": "Allemand"
    },
    "isDefault": false
  }
}

script:pre-request {
  const localeId = bru.getVar('localeId');

  if (!localeId) {
      await bru.runRequest('Authed/LocaleService/ListLocales');

      return;
  }
}

docs {
  # Update Locale

  Updates an existing locale by its ID.

  ## Request
  - `id` (required): The UUID of the locale to update
  - `code` (optional): New locale code
  - `names` (optional): Updated translations object
  - `isDefault` (optional): Whether this should be the default locale

  ## Behavior
  - If `isDefault` is changed from false to true, all other locales will have their `isDefault` flag set to false
  - Only provided fields will be updated

  ## Response
  Returns the updated locale.

  ## Example Response
  ```json
  {
    "locale": {
      "id": "uuid",
      "code": "de",
      "name": "Deutsch",
      "isDefault": false,
      "createdAt": "2026-03-27T18:12:31+01:00",
      "updatedAt": "2026-03-27T18:15:42+01:00"
    }
  }
  ```

  ## Errors
  - `INVALID_ARGUMENT`: locale id is required
  - `NOT_FOUND`: locale not found
  - `INTERNAL`: failed to update locale
}
