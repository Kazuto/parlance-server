meta {
  name: Refresh Token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/parlance.v1.AuthService/RefreshToken
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const body = res?.body;
  
  if (body) {
    bru.setEnvVar("accessToken", body.accessToken);
    bru.setEnvVar("refreshToken", body.refreshToken);
  }
}

docs {
  # Refresh Token
  
  Generates new access and refresh tokens from a valid refresh token.
  
  ## Request
  - `refreshToken` (required): A valid refresh token from login or registration
  
  ## Behavior
  - Validates the refresh token
  - Generates a new token pair (both access and refresh)
  - Old refresh token can still be used until it expires (stateless JWT)
  
  ## Response
  Returns new access and refresh tokens with updated user data.
  
  ## Example Response
  ```json
  {
    "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
    "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
    "user": {
      "id": "uuid",
      "email": "user@example.com",
      "name": "John Doe",
      "roles": [...],
      "createdAt": "2026-03-27T18:40:15+01:00",
      "updatedAt": "2026-03-27T18:40:15+01:00"
    }
  }
  ```
  
  ## Use Case
  When the access token expires (after 24h), use this endpoint to get a new one
  without requiring the user to login again.
  
  ## Errors
  - `INVALID_ARGUMENT`: refresh token is required
  - `UNAUTHENTICATED`: invalid or expired refresh token
  - `NOT_FOUND`: user not found
}
