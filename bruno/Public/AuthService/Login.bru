meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/parlance.v1.AuthService/Login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "user@example.com",
    "password": "securepassword123"
  }
}

script:post-response {
  const body = res?.body;
  
  if (body) {
    bru.setEnvVar("accessToken", body.accessToken);
    bru.setEnvVar("refreshToken", body.refreshToken);
  }
}

docs {
  # Login
  
  Authenticates a user with email and password, returns tokens.
  
  ## Request
  - `email` (required): User's email address
  - `password` (required): User's password
  
  ## Response
  Returns access tokens and user details with roles and permissions.
  
  ## Example Response
  ```json
  {
    "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
    "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
    "user": {
      "id": "uuid",
      "email": "user@example.com",
      "name": "John Doe",
      "roles": [
        {
          "id": "uuid",
          "name": "viewer",
          "permissions": [...]
        }
      ],
      "createdAt": "2026-03-27T18:40:15+01:00",
      "updatedAt": "2026-03-27T18:40:15+01:00"
    }
  }
  ```
  
  ## Token Expiry
  - **Access Token**: 24 hours (configurable via JWT_EXPIRY env var)
  - **Refresh Token**: 7x access token duration (default: 7 days)
  
  ## Errors
  - `INVALID_ARGUMENT`: email or password is required
  - `UNAUTHENTICATED`: invalid email or password
}
