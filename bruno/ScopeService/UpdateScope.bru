meta {
  name: Update Scope
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/parlance.v1.ScopeService/UpdateScope
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{scopeId}}",
    "name": "Mobile Applications",
    "description": "Mobile app translations for iOS and Android",
    "color": "#EC4899"
  }
}

docs {
  # Update Scope

  Updates an existing scope by its ID.

  ## Request
  - `id` (required): The UUID of the scope to update
  - `name` (optional): Updated scope name
  - `slug` (optional): Updated slug
  - `description` (optional): Updated description
  - `color` (optional): Updated hex color code

  ## Behavior
  Only provided fields will be updated.

  ## Response
  Returns the updated scope.

  ## Example Response
  ```json
  {
    "scope": {
      "id": "uuid",
      "name": "Mobile Applications",
      "slug": "mobile",
      "description": "Mobile app translations for iOS and Android",
      "color": "#EC4899",
      "createdAt": "2026-03-27T18:45:00+01:00",
      "updatedAt": "2026-03-27T18:47:00+01:00"
    }
  }
  ```

  ## Errors
  - `INVALID_ARGUMENT`: scope id is required
  - `NOT_FOUND`: scope not found
  - `INTERNAL`: failed to update scope
}
