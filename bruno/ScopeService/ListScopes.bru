meta {
  name: List Scopes
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/parlance.v1.ScopeService/ListScopes
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pagination": {
      "page": 1,
      "perPage": 20
    }
  }
}

docs {
  # List Scopes
  
  Retrieves a paginated list of all scopes in the system.
  
  ## Request
  - `pagination.page` (optional): Page number, defaults to 1
  - `pagination.perPage` (optional): Items per page, defaults to 20, max 100
  
  ## Response
  Returns an array of scopes with pagination metadata.
  
  ## Example Response
  ```json
  {
    "scopes": [
      {
        "id": "uuid",
        "name": "Frontend",
        "slug": "frontend",
        "description": "Frontend UI translations",
        "color": "#3B82F6",
        "createdAt": "2026-03-27T18:27:04+01:00",
        "updatedAt": "2026-03-27T18:27:04+01:00"
      }
    ],
    "pagination": {
      "total": 5,
      "page": 1,
      "perPage": 20,
      "totalPages": 1
    }
  }
  ```
}
